{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2021",
    "lib": ["es2021"],
    "outDir": "./lib",
    "rootDir": ".",
    "declaration": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["lib", "node_modules"]
}
